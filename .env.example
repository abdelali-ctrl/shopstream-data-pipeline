# ================================
# ShopStream v2 - Environment Variables
# ================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to git.

# --------------------------------
# PostgreSQL (source system)
# --------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopstream
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# --------------------------------
# Azure Blob Storage (data lake)
# --------------------------------
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_CONTAINER=shopstream-datalake
# Recommended for this demo: create a container-level SAS token with read, write, list, create permissions.
# You can also use AZURE_STORAGE_CONNECTION_STRING instead of account + SAS token.
AZURE_STORAGE_SAS_TOKEN=your_sas_token
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# --------------------------------
# Snowflake (data warehouse)
# --------------------------------
# Note on SNOWFLAKE_SCHEMA: this is the *target* schema for the dbt profile
# (i.e., where dbt's run-context schema starts). The custom generate_schema_name
# macro then routes models to STAGING / CORE / MARTS based on dbt_project.yml.
# Keep this set to RAW; the warehouse-side landing tables live there.
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_DATABASE=SHOPSTREAM_DWH
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_LOADING_WAREHOUSE=LOADING_WH
SNOWFLAKE_SCHEMA=RAW
