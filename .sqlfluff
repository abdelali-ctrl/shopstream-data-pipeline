[sqlfluff]
dialect = snowflake
templater = jinja
runaway_limit = 10
max_line_length = 120
ignore_templated_areas = True
# Suppress TMP (undefined dbt_utils vars) and PRS (parse errors from macros)
# — both are artifacts of using the jinja templater without full dbt context.
ignore = templating,parsing
# Exclude rules that conflict with the project's deliberate formatting choices:
# LT01 — multiple spaces before AS (column alignment style)
# LT09 — select targets on new line (fires on CTE select *)
# LT02 — indentation (confused by dbt_utils macro call lines)
# AL01 — implicit table aliasing (project uses "from orders o" style)
# CV03 — trailing comma (inconsistent in existing models, enforce later)
# ST06 — column order (too opinionated)
# RF04 — keywords as identifiers (e.g. "email" column name)
# AM06 — GROUP BY column references
exclude_rules = LT01,LT09,LT02,AL01,CV03,ST06,RF04,AM06

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper
